# ── Firebase Configuration ──────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Site URL & Identity ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Administrator Configuration ─────────────────────────────────────────────
ADMIN_EMAIL=mohammadbitullah@gmail.com
NEXT_PUBLIC_ADMIN_EMAIL=mohammadbitullah@gmail.com

# ── Security & Authentication Keys ──────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
ADMIN_SECRET_KEY=your_secure_admin_secret_key_here

# ── Image Uploads (ImgBB) ───────────────────────────────────────────────────
IMGBB_API_KEY=your_imgbb_api_key_here
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here

# ── SEO Verification Tokens ───────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_token_here
NEXT_PUBLIC_BING_SITE_VERIFICATION=your_bing_verification_token_here
